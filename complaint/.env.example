# UrbanSync Environment Variables Example

# Server & Application
APP_NAME=UrbanSync
PORT=8000
HOST=0.0.0.0

# Database (Default: SQLite local database; Can be upgraded to PostgreSQL or MySQL)
DATABASE_URL=sqlite:///./urbansync.db

# Authentication & Security
JWT_SECRET=urbansync-super-secret-development-key-2026-secure
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth Integration (Optional: Local fallback available if left empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Machine Learning Service Configuration
ML_CONFIDENCE_THRESHOLD=0.75
ML_REVIEW_THRESHOLD=0.50

# Storage
UPLOAD_MAX_SIZE_MB=10
